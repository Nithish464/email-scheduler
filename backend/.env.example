PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/email_scheduler
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth - get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Session secret - use a long random string in production
SESSION_SECRET=supersecretchangethisinproduction

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:3000

# Ethereal Email - auto-generated on first run, or set manually
# Get from https://ethereal.email
ETHEREAL_USER=
ETHEREAL_PASS=

# Worker config
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=200
MIN_DELAY_BETWEEN_EMAILS=2000
